# ============================================================
#  RemindFlow v4.1.0 — Variables de Entorno
# ============================================================

PORT=3000
NODE_ENV=development

# Base de datos SQLite
# Railway: configura un Volume apuntando a /app/data y usa DB_PATH=/app/data/remindflow.db
# Local: dejar vacío usa ./data/remindflow.db por defecto
DB_PATH=./data/remindflow.db

# Login
APP_USERNAME=admin
APP_PASSWORD=tu_contraseña_segura
JWT_SECRET=texto_largo_aleatorio_para_jwt

# Cifrado AES-256 — credenciales de redes sociales
# Genera uno seguro con: node -e "require('crypto').randomBytes(48).toString('hex') |> console.log"
# Mínimo recomendado: 32 caracteres aleatorios
CIPHER_SECRET=cambia_esto_por_un_secreto_aleatorio_largo_y_unico

# Gmail
GMAIL_USER=sotoroadmin@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_FROM_NAME=Sotoro Management

# WhatsApp — Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Twilio Webhook (configura esta URL en console.twilio.com)
# → Messaging → Sandbox → "When a message comes in"
# → URL: https://tu-servidor.railway.app/webhooks/twilio/webhook-twilio
# → Method: POST

# API Key (acceso programático, opcional)
API_SECRET_KEY=clave_para_scripts_externos
